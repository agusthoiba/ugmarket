<section id="katalog" class="ugs-section" data-testid="catalog-section">
  <div class="container-xxl">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-4 reveal">
      <div>
        <p class="section-eyebrow">// Etalase hidup</p>
        <h2 class="section-title" data-testid="catalog-title">Preview katalog merchandise</h2>
        <p class="section-sub">Kategori yang paling dicari pembeli — produk Anda berikutnya bisa tampil di sini.</p>
      </div>
      <div class="d-flex flex-wrap gap-2" data-testid="catalog-filter-tabs">
        <% data.catalogTabs.forEach(function(t, i) { %>
          <button class="tab-ugs <%= i === 0 ? 'active' : '' %>" data-filter="<%= t %>" data-testid="filter-tab-<%= t.toLowerCase() %>"><%= t %></button>
        <% }); %>
      </div>
    </div>

    <div class="row g-4 mt-4" data-testid="catalog-grid">
      <% data.products.forEach(function(p) { %>
        <div class="col-sm-6 col-lg-3 product-col" data-cat="<%= p.cat %>">
          <a href="https://merch.undergroundsync.com/products" target="_blank" rel="noopener" class="product-card reveal" data-testid="product-card-<%= p.slug %>">
            <div class="product-frame spotlight">
              <img src="<%= p.img %>" alt="<%= p.band %> - <%= p.name %>" loading="lazy">
              <span class="product-badge"><%= p.cat %></span>
              <span class="product-go"><i class="bi bi-arrow-up-right"></i></span>
            </div>
            <div class="d-flex justify-content-between align-items-start gap-3 mt-3">
              <div>
                <p class="product-band"><%= p.band %></p>
                <h3 class="product-name"><%= p.name %></h3>
              </div>
              <p class="product-price"><%= p.price %></p>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
  </div>
</section>
